# Database
DATABASE_URL="postgresql://printfarm:printfarm_dev@localhost:5432/printfarm_dev"

# Server
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# WebSocket
NEXT_PUBLIC_WS_URL="ws://localhost:3000"

# Printer Configuration
PRINTER_WIFI_TIMEOUT=5000
PRINTER_HEARTBEAT_INTERVAL=30000

# Pricing Defaults
DEFAULT_KWH_RATE=0.12
DEFAULT_MARGIN_PERCENTAGE=30

# Features
ENABLE_AUTO_QUEUE=true
ENABLE_REALTIME_UPDATES=true

# Authentication (for future implementation)
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"

# API Keys (for future integrations)
# OCTOPRINT_API_KEY=""
# STRIPE_API_KEY=""
